# 브라우저에 포함되는 VITE_ 접두사를 사용하지 마세요.
# 이 값은 scripts/sync-nutrition.mjs에서만 읽습니다.
NUTRI_API_KEY=replace_with_reissued_key

# Firebase Web 앱 등록 후 받은 구성값입니다. Firebase Web API 키는 식별자이지만
# Firebase Console에서 허용 도메인·API 제한을 설정하고 다른 서비스 키와 분리하세요.
VITE_FIREBASE_API_KEY=replace_with_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=replace_with_sender_id
VITE_FIREBASE_APP_ID=replace_with_app_id
